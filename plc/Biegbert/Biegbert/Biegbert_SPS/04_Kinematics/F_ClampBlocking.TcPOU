<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_ClampBlocking" Id="{22d474fa-d3fc-5dfe-880d-4907bd44f319}" SpecialFunc="None">
    <Declaration><![CDATA[// Paar (1..3), dessen Zone eine Z1-Fahrt von fFrom nach fTo kreuzt, obwohl einer seiner Niederhalter nicht offen ist; 0 = frei.
FUNCTION F_ClampBlocking : INT
VAR_INPUT
    fFrom : LREAL;
    fTo : LREAL;
END_VAR
VAR
    p : INT;
    a, b : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[a := MIN(fFrom, fTo);
b := MAX(fFrom, fTo);
FOR p := 1 TO 3 DO
    IF b > GVL_Config.aClampZoneLo_mm[p] AND a < GVL_Config.aClampZoneHi_mm[p] THEN
        IF NOT GVL_Devices.aClamp[2 * p - 1].IsOpen() OR NOT GVL_Devices.aClamp[2 * p].IsOpen() THEN
            F_ClampBlocking := p;
            RETURN;
        END_IF
    END_IF
END_FOR
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>