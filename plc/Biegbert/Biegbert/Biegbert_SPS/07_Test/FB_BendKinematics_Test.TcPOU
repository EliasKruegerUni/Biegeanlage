<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_BendKinematics_Test" Id="{7dc5a076-8c65-4f2f-84c2-f5a4be16b850}" SpecialFunc="None">
    <Declaration><![CDATA[// TcUnit-Tests ohne Achsen: Kinematik-Zustände ohne Plan, Alarmverwaltung, Niederhalter-Zustandsautomat.
// Läuft nur mit Compiler-Define TEST (MAIN ruft PRG_TEST).
FUNCTION_BLOCK FB_BendKinematics_Test EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[StartWithoutPlanIsRejected();
LoadPlanWithoutValidPlanIsRejected();
AlarmIsRemovedAfterClearAndAck();
StopAlarmCountsStopEvent();
]]></ST>
    </Implementation>
    <Method Name="StartWithoutPlanIsRejected" Id="{24d14f43-9aa7-5bab-a736-9c968f4e95e0}">
      <Declaration><![CDATA[METHOD StartWithoutPlanIsRejected
VAR
    fbKin : FB_BendKinematics;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('StartWithoutPlanIsRejected');
AssertFalse(Condition := fbKin.Start(), Message := 'Start ohne Plan muss abgelehnt werden');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="LoadPlanWithoutValidPlanIsRejected" Id="{9d46ee48-a8b5-507f-b954-4c4839d0cf7b}">
      <Declaration><![CDATA[METHOD LoadPlanWithoutValidPlanIsRejected
VAR
    fbKin : FB_BendKinematics;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('LoadPlanWithoutValidPlanIsRejected');
GVL_Plan.bValid := FALSE;
AssertFalse(Condition := fbKin.LoadPlan(nPlanId := 7), Message := 'LoadPlan ohne geprüften Plan muss abgelehnt werden');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AlarmIsRemovedAfterClearAndAck" Id="{79b3bcf1-7904-58ca-b8f1-d65e7501ac23}">
      <Declaration><![CDATA[METHOD AlarmIsRemovedAfterClearAndAck
VAR
    fbAl : FB_AlarmManager;
    stOut : ST_HmiAlarms;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AlarmIsRemovedAfterClearAndAck');
fbAl.Raise(E_AlarmCode.ClampTimeout, E_AlarmSeverity.Fault, 3, 0);
fbAl.WriteTo(stOut);
AssertEquals_UINT(Expected := 1, Actual := stOut.nCount, Message := 'ein Eintrag erwartet');
AssertTrue(Condition := fbAl.FaultActive(), Message := 'Fault muss aktiv sein');
fbAl.Ack(0);
fbAl.WriteTo(stOut);
AssertEquals_UINT(Expected := 1, Actual := stOut.nCount, Message := 'quittiert, aber Ursache besteht noch');
fbAl.Clear(E_AlarmCode.ClampTimeout, 3, FALSE);
fbAl.WriteTo(stOut);
AssertEquals_UINT(Expected := 0, Actual := stOut.nCount, Message := 'Eintrag muss entfernt sein');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopAlarmCountsStopEvent" Id="{36c14c3b-9bd2-55c6-815a-5f583590cd16}">
      <Declaration><![CDATA[METHOD StopAlarmCountsStopEvent
VAR
    fbAl : FB_AlarmManager;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('StopAlarmCountsStopEvent');
fbAl.Raise(E_AlarmCode.AxisSoftLimit, E_AlarmSeverity.Warning, 1, 0);
AssertEquals_UDINT(Expected := 0, Actual := fbAl.nStopCounter, Message := 'Warnung darf nicht pausieren');
fbAl.Raise(E_AlarmCode.HmiHeartbeatLost, E_AlarmSeverity.Stop, 0, 0);
AssertEquals_UDINT(Expected := 1, Actual := fbAl.nStopCounter, Message := 'Stop muss zählen');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>