<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_PlanHeader" Id="{76cf792d-d7a9-5718-bf57-b454907530bc}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '1'}
TYPE ST_PlanHeader :
STRUCT
    nPlanId : UDINT;
    nFormat : UINT;           // = GVL_Config.cPlanFormat
    nSectionCount : UINT;
    nPointCount : UDINT;
    nChecksum : UDINT;        // F_PlanChecksum über die belegten Abschnitte und Punkte
    stMaterial : ST_Material;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
