<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{3c8b17dd-a8bc-4093-9d78-6da4f5104d49}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
// Zyklusreihenfolge nach docs/architektur.md:
// 1 Eingänge, 2 Kommandos, 3 Abläufe, 4 Kinematik und Geräte, 5 Ausgänge, 6 Status und Alarme.
VAR
    fbIo : FB_IoMap;
    fbCmd : FB_HmiCommand;
    fbMode : FB_ModeManager;
    fbSeq : FB_BendSequence;
    fbPlan : FB_PlanStore;
    fbInterlocks : FB_Interlocks;
    fbStatus : FB_HmiStatus;
    dwBaseMissing : DWORD;
    bKinLock : BOOL;
    abSimFault : ARRAY[1..5] OF BOOL;
    bSim : BOOL;
    bInit : BOOL := TRUE;
    i : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1 Eingänge
fbIo.ReadInputs();
bSim := fbIo.IsSimulation();
IF bInit THEN
    bInit := FALSE;
    IF bSim THEN
        GVL_Devices.fbAlarm.Raise(E_AlarmCode.SimulationActive, E_AlarmSeverity.Info, 0, 0);
    END_IF
END_IF
{IF defined (SIM)}
abSimFault := GVL_Sim.abAxisFault;
{END_IF}

// 2 Kommandos
dwBaseMissing := fbStatus.CalcBaseMissing(fbSeq.bMaterialOk);
fbCmd(fbMode := fbMode, fbSeq := fbSeq, fbPlan := fbPlan, dwBaseMissing := dwBaseMissing, bSimulation := bSim);

// 3 Abläufe
fbMode(bEStopActive := GVL_IO.bEStopActive, bSafetyOk := GVL_IO.bSafetyOk,
       nStopCounter := GVL_Devices.fbAlarm.nStopCounter);
fbSeq(bFree := fbMode.bFree, bAbort := fbMode.bEnteredSingle, bInit := fbMode.bInitSequences);

// 4 Kinematik und Geräte
GVL_Devices.fbKin.Cyclic();
bKinLock := GVL_Devices.fbKin.IsCoupled();
GVL_Devices.aAxis[1](pAxis := ADR(GVL_Axis.Z1), nIndex := 1, bAllowPower := NOT GVL_IO.bEStopActive,
    bLockedByKin := bKinLock, bSimFault := abSimFault[1], fTorque_Nm := GVL_IO.afTorque_Nm[1],
    fPowerOverride_pct := SEL(bKinLock, 100.0, GVL_HMI.stStatus.stParamActive.fFeedOverride_pct));
GVL_Devices.aAxis[2](pAxis := ADR(GVL_Axis.Z2), nIndex := 2, bAllowPower := NOT GVL_IO.bEStopActive,
    bLockedByKin := FALSE, bSimFault := abSimFault[2], fTorque_Nm := GVL_IO.afTorque_Nm[2]);
GVL_Devices.aAxis[3](pAxis := ADR(GVL_Axis.X), nIndex := 3, bAllowPower := NOT GVL_IO.bEStopActive,
    bLockedByKin := bKinLock, bSimFault := abSimFault[3], fTorque_Nm := GVL_IO.afTorque_Nm[3]);
GVL_Devices.aAxis[4](pAxis := ADR(GVL_Axis.A), nIndex := 4, bAllowPower := NOT GVL_IO.bEStopActive,
    bLockedByKin := bKinLock, bSimFault := abSimFault[4], fTorque_Nm := GVL_IO.afTorque_Nm[4]);
GVL_Devices.aAxis[5](pAxis := ADR(GVL_Axis.W), nIndex := 5, bAllowPower := NOT GVL_IO.bEStopActive,
    bLockedByKin := FALSE, bSimFault := abSimFault[5], fTorque_Nm := GVL_IO.afTorque_Nm[5]);
FOR i := 1 TO 6 DO
    GVL_Devices.aClamp[i](bSensorOpen := GVL_IO.abClampOpen[i], bPressureOk := GVL_IO.bPressureOk,
                          bForceOpen := GVL_IO.bEStopActive);
    GVL_IO.abClampValve[i] := GVL_Devices.aClamp[i].bValve;
END_FOR
fbInterlocks();

// 5 Ausgänge
fbIo.WriteOutputs();

// 6 Status und Alarme
fbStatus(fbMode := fbMode, fbSeq := fbSeq, bHmiAlive := fbCmd.bHmiAlive, bSimulation := bSim,
         dwBaseMissing := dwBaseMissing);
GVL_Devices.fbAlarm.WriteTo(GVL_HMI.stAlarm);

{IF defined (TEST)}
PRG_TEST();
{END_IF}
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>