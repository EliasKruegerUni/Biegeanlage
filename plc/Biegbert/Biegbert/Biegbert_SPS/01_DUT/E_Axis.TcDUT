<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_Axis" Id="{b1cb1816-7d85-457c-9f32-2a1422d00e17}">
    <Declaration><![CDATA[// Achsen. Die Werte sind die Indizes von aAxis in ST_HmiStatus.
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_Axis :
(
    None := 0, // keine Achse
    Z1 := 1, // Vorschub, mm
    Z2 := 2, // Führung, mm
    X := 3, // Matrizenauslenkung, mm
    A := 4, // Matrizendrehung, °
    W := 5 // Rohrdrehung, °, Modulo
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>