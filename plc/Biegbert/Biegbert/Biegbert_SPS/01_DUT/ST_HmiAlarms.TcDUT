STRUCT
    nChangeCounter : UDINT; // bei jeder Änderung +1
    nCount : UINT;
    bOverflow : BOOL;
    eHighestSeverity : E_AlarmSeverity;
    aEntry : ARRAY[1..32] OF ST_AlarmEntry;
END_STRUCT
END_TYPE
]]></Declaration>
