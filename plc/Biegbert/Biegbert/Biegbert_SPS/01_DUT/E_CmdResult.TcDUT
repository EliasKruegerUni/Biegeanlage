<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_CmdResult" Id="{dde53f64-b9a5-4b5f-b3c1-8c1b55270a2c}">
    <Declaration><![CDATA[// Ergebnis der Kommandoprüfung.
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_CmdResult :
(
    None := 0, // noch keine Antwort
    Accepted := 1, // angenommen, Ausführung siehe Status
    RejectedUnknown := 2, // Kommando unbekannt
    RejectedMode := 3, // in dieser Betriebsart nicht erlaubt
    RejectedInterlock := 4, // Verriegelung aktiv
    RejectedParam := 5, // Parameter ungültig
    RejectedSequence := 6, // zweite Stufe ohne gültige erste Stufe
    RejectedBusy := 7 // Gerät beschäftigt
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>