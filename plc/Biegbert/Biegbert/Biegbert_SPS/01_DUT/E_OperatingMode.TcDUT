  <DUT Name="E_OperatingMode" Id="{5bb7fb0f-d8d9-415b-8725-460b8ce504db}">
    <Declaration><![CDATA[// Betriebsart. Die Werte entsprechen den GRAFCET-Schritten von G1.
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_OperatingMode :
(
    Automatic := 10, // G1 Schritt 10
    Pause := 11, // G1 Schritt 11
    SingleAxis := 12, // G1 Schritt 12
    ReturnToBase := 13 // G1 Schritt 13
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>