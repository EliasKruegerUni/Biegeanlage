<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_ClampState" Id="{0583542f-4cd5-413d-8c6e-3438c63be5a9}">
    <Declaration><![CDATA[// Zustand eines Niederhalters.
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ClampState :
(
    Unknown := 0,
    Open := 1, // Endlage OFFEN gemeldet
    Closing := 2, // Ventil an, Schaltzeit läuft
    Clamped := 3, // OFFEN verlassen, Druck ok, Schaltzeit abgelaufen
    Opening := 4, // Ventil aus, Endlage noch nicht erreicht
    Fault := 5 // Zeitüberwachung oder Plausibilität verletzt
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>